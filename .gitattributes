# Unity text assets
*.cs text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.controller text eol=lf
